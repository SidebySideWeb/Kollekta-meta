# Generate with: openssl rand -hex 32
META_ADMIN_PASSWORD=
META_SESSION_SECRET=

# Fixed — do not change. Server asserts 127.0.0.1 and refuses anything else.
HOST=127.0.0.1
PORT=4000

# Instance folders (Μέρος Α). Production default: /srv/kollekta/instances
INSTANCE_DATA_ROOT=/srv/kollekta/instances
KOLLEKTA_IMAGE=kollekta:latest

# Nginx (Μέρος Α / step 3)
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_SECURITY_SNIPPET=/etc/nginx/snippets/kollekta-security-headers.conf
SSL_FULLCHAIN=/etc/letsencrypt/live/kollekta.gr/fullchain.pem
SSL_PRIVKEY=/etc/letsencrypt/live/kollekta.gr/privkey.pem

# Shared SMTP account written into every customer prod.env
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Local debugging only — never enable in production
# RATE_LIMIT_DISABLED=true
